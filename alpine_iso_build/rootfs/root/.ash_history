echo "http://dl-cdn.alpinelinux.org/alpine/v3.20/community" >> /etc/apk/repositories
apk update
apk add xorg-server lxde-common openbox lxterminal lxdm
sudo cp /etc/resolv.conf ./alpine_iso_build/rootfs/etc/resolv.conf
# 1. Write Google's public DNS server into resolv.conf
echo "nameserver 8.8.8.8" > /etc/resolv.conf
# 2. Update package repositories now that DNS works
apk update
# 3. Install LXDE and display components
apk add xorg-server lxde openbox lxterminal lxdm
apk add xorg-server lxde-common lxpanel pcmanfm openbox lxterminal lxdm
echo "https://dl-cdn.alpinelinux.org/alpine/v3.20/community" >> /etc/apk/repositories
apk update
apk add xorg-server openbox pcmanfm lxterminal lxdm
exit
